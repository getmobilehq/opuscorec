// OpusCore Database Schema - SQLite Version for Testing
// Based on OpusCore Master Build Prompt v2 - Section 4 (ERD)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// SECTION 1: Core Identity & Organization
// ============================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("USER")
  teamId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  team                Team?                @relation(fields: [teamId], references: [id])
  ownedBAUProcesses   BAUProcess[]         @relation("BAUProcessOwner")
  sponsoredPrograms   Program[]            @relation("ProgramSponsor")
  managedPrograms     Program[]            @relation("ProgramManager")
  ledWorkstreams      Workstream[]         @relation("WorkstreamLead")
  assignedTasks       Task[]               @relation("TaskAssignee")
  ownedKPIs           KPI[]                @relation("KPIOwner")
  ownedOKRs           OKR[]                @relation("OKROwner")
  createdBAUVersions  BAUProcessVersion[]
  createdSignals      Signal[]
  createdMetricEvents MetricEvent[]

  @@index([email])
  @@index([teamId])
  @@map("users")
}

model Team {
  id           String  @id @default(cuid())
  name         String
  department   String?
  parentTeamId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  parentTeam     Team?         @relation("TeamHierarchy", fields: [parentTeamId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childTeams     Team[]        @relation("TeamHierarchy")
  members        User[]
  bauProcesses   BAUProcess[]
  kpis           KPI[]
  okrs           OKR[]
  metricEvents   MetricEvent[]

  @@index([parentTeamId])
  @@map("teams")
}

// ============================================
// SECTION 2: BAU (Business as Usual)
// ============================================

model BAUProcess {
  id          String   @id @default(cuid())
  name        String
  description String
  ownerId     String
  teamId      String
  systemIds   String   // JSON string for SQLite
  status      String   @default("DRAFT")
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner         User                @relation("BAUProcessOwner", fields: [ownerId], references: [id])
  team          Team                @relation(fields: [teamId], references: [id])
  versions      BAUProcessVersion[]
  linkedTasks   Task[]
  programLinks  ProgramBAULink[]

  @@index([ownerId])
  @@index([teamId])
  @@index([status])
  @@map("bau_processes")
}

model BAUProcessVersion {
  id            String   @id @default(cuid())
  bauProcessId  String
  version       Int
  content       String   // JSON string for SQLite
  createdAt     DateTime @default(now())
  createdById   String

  // Relations
  bauProcess BAUProcess @relation(fields: [bauProcessId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id])

  @@unique([bauProcessId, version])
  @@index([bauProcessId])
  @@map("bau_process_versions")
}

// ============================================
// SECTION 3: Programs & Workstreams
// ============================================

model Program {
  id          String   @id @default(cuid())
  name        String
  description String?
  sponsorId   String
  managerId   String
  scope       String?
  status      String   @default("DRAFT")
  healthScore Int?     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  sponsor       User             @relation("ProgramSponsor", fields: [sponsorId], references: [id])
  manager       User             @relation("ProgramManager", fields: [managerId], references: [id])
  workstreams   Workstream[]
  workshops     Workshop[]
  tasks         Task[]
  bauLinks      ProgramBAULink[]
  okrs          OKR[]
  kpis          KPI[]

  @@index([sponsorId])
  @@index([managerId])
  @@index([status])
  @@map("programs")
}

model Workstream {
  id          String   @id @default(cuid())
  programId   String
  name        String
  description String?
  leadId      String?
  status      String   @default("planning")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  program Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lead    User?    @relation("WorkstreamLead", fields: [leadId], references: [id])
  tasks   Task[]
  okrs    OKR[]
  kpis    KPI[]

  @@index([programId])
  @@index([leadId])
  @@map("workstreams")
}

model ProgramBAULink {
  id           String   @id @default(cuid())
  programId    String
  bauProcessId String
  linkType     String   @default("impacted")
  createdAt    DateTime @default(now())

  // Relations
  program    Program    @relation(fields: [programId], references: [id], onDelete: Cascade)
  bauProcess BAUProcess @relation(fields: [bauProcessId], references: [id], onDelete: Cascade)

  @@unique([programId, bauProcessId])
  @@index([programId])
  @@index([bauProcessId])
  @@map("program_bau_links")
}

// ============================================
// SECTION 4: Workshops
// ============================================

model Workshop {
  id           String   @id @default(cuid())
  programId    String
  type         String
  name         String?
  description  String?
  scheduledFor DateTime?
  status       String   @default("PLANNED")
  outputsRef   String?
  agenda       String?  // JSON string
  outcomes     String?  // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([programId])
  @@index([status])
  @@map("workshops")
}

// ============================================
// SECTION 5: Tasks
// ============================================

model Task {
  id            String    @id @default(cuid())
  type          String
  title         String
  description   String?
  status        String    @default("OPEN")
  assignedToId  String?
  programId     String?
  bauProcessId  String?
  workstreamId  String?
  workshopId    String?
  payload       String?   // JSON string
  dueDate       DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  assignedTo  User?       @relation("TaskAssignee", fields: [assignedToId], references: [id])
  program     Program?    @relation(fields: [programId], references: [id], onDelete: Cascade)
  bauProcess  BAUProcess? @relation(fields: [bauProcessId], references: [id])
  workstream  Workstream? @relation(fields: [workstreamId], references: [id])
  workshop    Workshop?   @relation(fields: [workshopId], references: [id])

  @@index([assignedToId])
  @@index([programId])
  @@index([status])
  @@index([dueDate])
  @@map("tasks")
}

// ============================================
// SECTION 6: KPIs & OKRs
// ============================================

model KPI {
  id           String   @id @default(cuid())
  name         String
  description  String?
  ownerId      String
  teamId       String?
  programId    String?
  workstreamId String?
  scope        String
  targetValue  Float
  currentValue Float    @default(0)
  unit         String
  period       String
  status       String   @default("ON_TRACK")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  owner        User        @relation("KPIOwner", fields: [ownerId], references: [id])
  team         Team?       @relation(fields: [teamId], references: [id])
  program      Program?    @relation(fields: [programId], references: [id], onDelete: Cascade)
  workstream   Workstream? @relation(fields: [workstreamId], references: [id])
  metricEvents MetricEvent[]

  @@index([ownerId])
  @@index([teamId])
  @@index([scope])
  @@index([period])
  @@map("kpis")
}

model OKR {
  id           String   @id @default(cuid())
  ownerId      String
  teamId       String?
  programId    String?
  workstreamId String?
  scope        String
  period       String
  objective    String
  status       String   @default("ON_TRACK")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  owner      User         @relation("OKROwner", fields: [ownerId], references: [id])
  team       Team?        @relation(fields: [teamId], references: [id])
  program    Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)
  workstream Workstream?  @relation(fields: [workstreamId], references: [id])
  keyResults KeyResult[]

  @@index([ownerId])
  @@index([teamId])
  @@index([scope])
  @@index([period])
  @@map("okrs")
}

model KeyResult {
  id           String   @id @default(cuid())
  okrId        String
  description  String
  targetValue  Float
  currentValue Float    @default(0)
  unit         String
  status       String   @default("ON_TRACK")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  okr OKR @relation(fields: [okrId], references: [id], onDelete: Cascade)

  @@index([okrId])
  @@map("key_results")
}

// ============================================
// SECTION 7: Signals & Metrics
// ============================================

model Signal {
  id        String   @id @default(cuid())
  type      String
  source    String
  payload   String   // JSON string
  createdAt DateTime @default(now())
  createdBy String?

  // Relations
  creator User? @relation(fields: [createdBy], references: [id])

  @@index([type])
  @@index([createdAt])
  @@map("signals")
}

model MetricEvent {
  id        String   @id @default(cuid())
  eventType String
  sourceId  String
  ownerId   String?
  teamId    String?
  kpiId     String?
  value     Float?
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  // Relations
  owner User?  @relation(fields: [ownerId], references: [id])
  team  Team?  @relation(fields: [teamId], references: [id])
  kpi   KPI?   @relation(fields: [kpiId], references: [id])

  @@index([eventType])
  @@index([sourceId])
  @@index([createdAt])
  @@index([kpiId])
  @@map("metric_events")
}
