{
  "name": "opuscore",
  "version": "0.1.0",
  "private": true,
  "description": "OpusCore - Operational Operating System for BAU Intelligence, Program Orchestration, and Executive Insight",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@opuscore/api",
    "dev:web": "npm run dev --workspace=@opuscore/web",
    "dev:ai": "npm run dev --workspace=@opuscore/ai-orchestrator",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=@opuscore/api",
    "test": "npm run test --workspaces --if-present",
    "test:cov": "npm run test:cov --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint --workspaces --if-present -- --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "npm run db:generate --workspace=@opuscore/database",
    "db:migrate": "npm run db:migrate --workspace=@opuscore/database",
    "db:migrate:dev": "npm run db:migrate:dev --workspace=@opuscore/database",
    "db:studio": "npm run db:studio --workspace=@opuscore/database",
    "db:seed": "npm run db:seed --workspace=@opuscore/database",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist packages/*/dist",
    "clean:build": "rm -rf apps/*/dist packages/*/dist",
    "docker:build": "docker build -t opuscore-api -f apps/api/Dockerfile .",
    "docker:run": "docker run -p 3000:3000 --env-file .env opuscore-api",
    "ci:install": "npm ci",
    "ci:build": "npm run db:generate && npm run build",
    "ci:test": "npm run test",
    "ci:lint": "npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "prettier": "^3.1.0",
    "eslint": "^8.55.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
